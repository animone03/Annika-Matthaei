{
  "name": "single-owner-sanity-next-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "studio:dev": "sanity dev",
    "studio:deploy": "sanity deploy",
    "sanity:schema": "sanity schema extract --enforce-required-fields --force",
    "sanity:typegen": "pnpm sanity:schema && sanity typegen generate",
    "sanity:typegen:check": "pnpm sanity:typegen && git diff --exit-code -- schema.json sanity.types.ts",
    "sanity:validate": "sanity documents validate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@portabletext/react": "8.0.1",
    "@sanity/client": "7.26.2",
    "@sanity/image-url": "2.1.1",
    "next": "16.3.3",
    "next-sanity": "13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
